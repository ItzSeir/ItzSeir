2. HERO (每個頁面標題上面）
<div id="siteAnnouncement"></div>

3. </body> 前面
<script>
(async () => {
  const box = document.getElementById("siteAnnouncement");
  if(!box) return;

  try{
    const res = await fetch("data/announcement.json?t=" + Date.now());
    const data = await res.json();

    if(!data.enabled){
      box.remove();
      return;
    }

    const items = Array.isArray(data.items) ? data.items : [];

    box.innerHTML = `
      <div class="announcementBar">
        <div class="announcementIcon">📢</div>

        <div class="announcementContent">
          <div class="announcementTitle">${escapeHtml(data.title || "重要公告")}</div>

          <div class="announcementList">
            ${
              items.map(item => `
                <div class="announcementItem">
                  <strong>${escapeHtml(item.label || "")}</strong>
                  <span>${escapeHtml(item.text || "")}</span>
                </div>
              `).join("")
            }
          </div>

          <div class="announcementTime">
            更新時間：${escapeHtml(data.updated || "")}
          </div>
        </div>
      </div>
    `;
  }catch(e){
    console.log(e);
    box.remove();
  }

  function escapeHtml(text){
    return String(text || "")
      .replaceAll("&","&amp;")
      .replaceAll("<","&lt;")
      .replaceAll(">","&gt;")
      .replaceAll('"',"&quot;")
      .replaceAll("'","&#039;");
  }
})();
</script>
